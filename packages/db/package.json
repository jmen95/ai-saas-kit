{
  "name": "@repo/db",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "npm run db:generate && tsc",
    "db:generate": "dotenv -e ../../apps/api/.env -e .env -- prisma generate --schema=./prisma/schema.prisma",
    "db:migrate": "dotenv -e ../../apps/api/.env -e .env -- prisma migrate dev --schema=./prisma/schema.prisma",
    "db:push": "dotenv -e ../../apps/api/.env -e .env -- prisma db push --schema=./prisma/schema.prisma",
    "db:studio": "dotenv -e ../../apps/api/.env -e .env -- prisma studio --schema=./prisma/schema.prisma",
    "db:seed": "dotenv -e ../../apps/api/.env -e .env -- tsx prisma/seed.ts",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0"
  },
  "devDependencies": {
    "@repo/typescript-config": "*",
    "dotenv-cli": "^10.0.0",
    "prisma": "^6.19.0",
    "tsx": "^4.22.4",
    "typescript": "5.9.2"
  }
}
